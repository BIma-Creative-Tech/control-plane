# Salin ke .env (chmod 600, TIDAK di-commit). Semua divalidasi Zod saat boot (src/env.ts).
NODE_ENV=production
LOG_LEVEL=info

# Postgres shared (network `db`). Password = PG_CONTROL_PLANE_PASSWORD di /opt/infra/postgres/.env
DATABASE_URL=postgresql://control_plane:CHANGE_ME@postgres:5432/control_plane

# Auth.js v5 — nama variabel dibaca Auth.js (node_modules/@auth/core/lib/utils/env.js)
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_48
AUTH_URL=https://cp.bimacreative.tech
AUTH_KEYCLOAK_ID=control-plane
AUTH_KEYCLOAK_SECRET=CHANGE_ME_from_keycloak_client_credentials
AUTH_KEYCLOAK_ISSUER=https://auth.bimacreative.tech/realms/platform

# Tidak ada NEXT_PUBLIC_* yang berisi secret (ditolak env.ts).
