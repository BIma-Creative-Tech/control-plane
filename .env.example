# Salin ke .env (chmod 600, TIDAK di-commit). Semua divalidasi Zod saat boot (src/env.ts).
NODE_ENV=production
LOG_LEVEL=info

# Postgres shared (network `db`). Password = PG_CONTROL_PLANE_PASSWORD di /opt/infra/postgres/.env
DATABASE_URL=postgresql://control_plane:CHANGE_ME@postgres:5432/control_plane

# Auth.js v5 — nama variabel dibaca Auth.js (node_modules/@auth/core/lib/utils/env.js)
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_48
AUTH_URL=https://cp.bimacreative.tech
AUTH_KEYCLOAK_ID=control-plane
AUTH_KEYCLOAK_SECRET=CHANGE_ME_from_keycloak_client_credentials
AUTH_KEYCLOAK_ISSUER=https://auth.bimacreative.tech/realms/platform

# Jembatan job Odoo/SSO (plan 05, ADR 0009). Kosong = fitur job nonaktif (UI read-only).
# prod → env tenant prod|demo; staging → env tenant staging. Web DAN worker.
#INFRA_JOBS_INSTANCE=prod
# Allowlist tipe job instance ini (= job_types /etc/infra-jobs/<inst>.conf). Kosong = 5 tipe plan 05 (prod Fase 1).
# Staging Fase 1 (semua tipe, halaman /users aktif):
#INFRA_JOBS_TYPES=odoo_db_provision,odoo_route,odoo_sso_provision,odoo_sso_disable,odoo_sso_user,kc_realm_sync,kc_org_ensure,kc_user_ensure,kc_user_set_roles,kc_user_set_enabled,kc_user_action_email,odoo_user_ensure,odoo_tenant_config,tenant_suspend,tenant_resume
# Worker saja (bind mount dari compose; bukan path host): spool rw (berisi tmp/ + new/), hasil ro.
#INFRA_JOBS_SPOOL_DIR=/jobs/spool
#INFRA_JOBS_RESULTS_DIR=/jobs/results
#INFRA_JOBS_POLL_SECONDS=5
#INFRA_JOBS_QUEUE_GRACE_SECONDS=900

# W5 Domains: IPv4 publik platform untuk checklist DNS (record A odoo/web/insight). Kosong = "IP belum dikonfigurasi".
# Web saja; privat/loopback/link-local/CGNAT ditolak.
#PLATFORM_PUBLIC_IPV4=31.97.50.221
# Zona milik platform (koma): fqdn sama/di bawahnya ditolak sebagai domain tenant. Default bimacreative.tech.
#PLATFORM_DOMAINS=bimacreative.tech

# Tidak ada NEXT_PUBLIC_* yang berisi secret (ditolak env.ts).
